{
  "name": "chess-gambits",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node tools/content/compile-cli.ts && node tools/catalogue/build-cli.ts && vite",
    "build": "node tools/content/compile-cli.ts && node tools/catalogue/build-cli.ts && tsc -b && vite build && node scripts/generate-shells.ts",
    "preview": "vite preview",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --noEmit",
    "pretest": "node tools/catalogue/build-cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "serve:dist": "node scripts/static-server.ts",
    "validate:content": "node tools/content/cli.ts",
    "catalogue": "node tools/catalogue/build-cli.ts",
    "catalogue:freeze": "node tools/catalogue/freeze-cli.ts",
    "catalogue:fetch": "node tools/catalogue/fetch-cli.ts",
    "prove:mates": "node tools/mate/prove-cli.ts",
    "verify:mates": "node tools/mate/verify-cli.ts",
    "compile:content": "node tools/content/compile-cli.ts",
    "import-pgn": "node tools/content/import-cli.ts",
    "export-pgn": "node tools/content/export-cli.ts",
    "e2e": "playwright test",
    "perf:lighthouse": "npx --yes @lhci/cli@0.15.1 collect && npx --yes @lhci/cli@0.15.1 assert",
    "review:greyscale": "TEST_FLOOR=off playwright test e2e/greyscale-review.spec.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "chess.js": "1.4.0",
    "i18next": "26.4.2",
    "i18next-resources-to-backend": "1.2.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "17.0.14",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@mliebelt/pgn-parser": "1.4.19",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.0",
    "lint-staged": "^17.5.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.8",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "description": "Learn chess gambits and opening traps as a branching move tree",
  "license": "MIT",
  "engines": {
    "node": ">=24.12"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,cjs,json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
